POSTGRES_USER=observadoras
POSTGRES_DB=observadoras
POSTGRES_PASSWORD=
DATABASE_URL=
AUTH_SECRET=
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Enable only behind a trusted proxy that overwrites X-Real-IP; never trust arbitrary forwarded headers.
TRUST_PROXY=false
# Public server only, used by compose.production.yaml (hostname without scheme).
SITE_DOMAIN=observadoras.tecsify.com

# Server only. Never use NEXT_PUBLIC_ for API keys. Leave empty to keep AI disabled.
OPENAI_API_KEY=
OPENAI_MODEL=
# Real report analysis requires explicit consent recorded with the notice version.
AI_DATA_MODE=consented
AI_AUTOMATIC_ENABLED=true
